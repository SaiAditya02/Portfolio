prefix_rule(pattern = ["git", "gc", "--prune"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "tag", "--delete"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["glab", "mr", "create"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["glab", "mr", "merge"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["glab", "mr", "approve"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
