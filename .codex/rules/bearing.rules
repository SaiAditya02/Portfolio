# Codex execpolicy rules written by Bearing from brg-guard --verbs (trusted projects only).
# Most restrictive decision wins. The engineer pushes, merges and deploys; the agent prepares.
# Prefix rules cannot see wrappers (sudo, env, sh -c, git -C); the PreToolUse hook over
# .bearing/bin/brg-guard is the control and this file is the first line.
prefix_rule(pattern = ["git", "push"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "commit", "--amend"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "rebase"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "filter-repo"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "filter-branch"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "remote", "set-url"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "remote", "remove"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "remote", "rm"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "branch", "--delete", "--force"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
prefix_rule(pattern = ["git", "stash", "drop"], decision = "forbidden", justification = "the engineer runs this; prepare and print the command")
